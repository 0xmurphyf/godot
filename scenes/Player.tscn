[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Player.gd" id="1_player"]
[ext_resource type="SpriteFrames" path="res://art/player_frames.tres" id="2_frames"]

[sub_resource type="RectangleShape2D" id="Shape_body"]
size = Vector2(26, 48)

[sub_resource type="RectangleShape2D" id="Shape_hit"]
size = Vector2(52, 34)

[sub_resource type="RectangleShape2D" id="Shape_hurt"]
size = Vector2(30, 110)

[node name="Player" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 33
script = ExtResource("1_player")
max_health = 999
# iframe_ticks = 0 加上 hurt_invincible = false：玩家受击后完全不无敌，
# 连击会吃满伤害。翻滚无敌另走一套（Player._ready 里也会强制设，双保险）。
iframe_ticks = 0
hurt_invincible = false
min_x = 40.0
max_x = 1112.0
# 玩家落地不震屏。镜头跟着玩家，自己落地还震会让跑动时画面一直抖。
# 属性本身声明在 FrameActor 上，这里只覆盖数值 ——
# 在 Player.gd 里重新声明同名 @export 会触发 SHADOWED_VARIABLE_BASE_CLASS 警告。
# 扬尘和落地音保留：那两样是"落地了"的信息，不是负担。
land_shake_scale = 0.0

[node name="Sprite" type="AnimatedSprite2D" parent="."]
texture_filter = 0
position = Vector2(0, -48)
sprite_frames = ExtResource("2_frames")
autoplay = "idle"

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -24)
shape = SubResource("Shape_body")

[node name="Hitbox" type="Area2D" parent="."]
position = Vector2(20, -47)
collision_layer = 64
collision_mask = 16
monitorable = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hitbox"]
shape = SubResource("Shape_hit")

[node name="Hurtbox" type="Area2D" parent="."]
position = Vector2(0, -55)
collision_layer = 8
collision_mask = 0
monitoring = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hurtbox"]
shape = SubResource("Shape_hurt")
